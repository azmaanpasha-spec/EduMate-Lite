# EduMate Lite configuration
# Copy this file to backend/.env and fill in your values:
#   copy .env.example backend\.env

# Your Google Gemini API key (free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model to use. Leave empty to use the default (gemini-3.5-flash).
# Any model available to your key works, e.g. gemini-3.5-flash-lite (faster)
GEMINI_MODEL=

# SQLite database file (relative paths are inside the backend folder)
DATABASE_URL=sqlite:///./edumate.db

APP_ENV=development

# Backup models used automatically when the main model is busy (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional tuning
# GEMINI_THINKING_LEVEL=low     (minimal / low / medium / high; low is faster)
# CHAT_CONTEXT_MESSAGES=12
# AI_TIMEOUT_SECONDS=30         (per model attempt)
